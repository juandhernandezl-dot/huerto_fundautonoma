TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Backend del LLM: "ollama" (contenedor huerto-ollama, por defecto) u
# "openai" (LM Studio en el host). El nombre del modelo cambia por backend:
#   ollama -> qwen3.5:4b     openai/LM Studio -> qwen3.5-4b
LLM_BACKEND=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_CTX=4096

# Solo si LLM_BACKEND=openai:
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=your_llm_api_key_here

MAX_HISTORY_TURNS=4
# En CPU (PC sin GPU, Raspberry Pi 5) la primera respuesta tras un
# reinicio incluye cargar el modelo en RAM: 60 s puede quedarse corto.
REQUEST_TIMEOUT_S=120

WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=es

PIPER_VOICE_PATH=

MONGO_URI=mongodb://localhost:27019
MONGO_DB=huerto
MONGO_COLLECTION=telemetria
EVENTOS_COLLECTION=eventos

HISTORIAL_HORAS=24
TELEMETRY_STALE_MINUTES=60

# Carpeta del host donde Node-RED guarda flows.json y sus módulos.
# En la Raspberry Pi: /home/<usuario>/.node-red
NODERED_DATA=/home/reds7/.node-red